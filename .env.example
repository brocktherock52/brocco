# --- brocco.dev env vars ---
# Copy to .env.local for dev. Set on Vercel project for prod.

# Neon Postgres connection string.
# Get one at https://console.neon.tech > Project > Connection Details.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/brocco?sslmode=require

# 32+ random bytes; openssl rand -base64 32 or `npx better-auth secret`.
AUTH_SECRET=

# Base URL the auth handler builds magic links against.
# Set to https://brocco.dev in prod.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email provider for magic links. Resend recommended.
# Sign up: https://resend.com (free tier 3k/mo)
RESEND_API_KEY=
EMAIL_FROM="Brocco <login@brocco.dev>"

# Existing brocco env vars (already used by other routes; listed here
# so a single .env.local hydrates the whole app).
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=

# --- Analytics / growth (user-journey tracking) ---
# PostHog powers the activation funnel + user-journey map (signup -> first run
# -> activated -> retained). Without these the analytics layer is a silent
# no-op. Create a project at https://posthog.com (free tier is generous).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta (Facebook/Instagram) Pixel for paid-social retargeting + conversion
# tracking. Get the ID from Meta Events Manager. Optional.
NEXT_PUBLIC_META_PIXEL_ID=

# Test-only: enables /api/__test/last-magic-link. NEVER set in prod.
ALLOW_TEST_ENDPOINTS=0

# --- Marketing video engine (see marketing/MASTER_MARKETING_PLAN_2026-05-27.md) ---
# PRIMARY = free local engine (ComfyUI + Wan 2.2 on the local GPU). No key needed.
# Just point the driver at the running ComfyUI server:
COMFY_HOST=127.0.0.1:8188

# OPTIONAL paid fallback (scripts/providers.py) for burst / no-GPU rendering via
# fal.ai. Pay-per-render, commercial-licensed. Leave blank to stay 100% free/local.
FAL_KEY=
FAL_DAILY_CAP_USD=3
FAL_MONTHLY_CAP_USD=60

# OPTIONAL hosted voice (scripts/tts.py prefers local Kokoro; this is only if you
# ever want ElevenLabs instead). Starter ($5/mo) is the commercial-use floor.
ELEVENLABS_API_KEY=
