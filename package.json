    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
