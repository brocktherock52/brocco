{
  "id": "brocco-ai-app",
  "name": "brocco.ai - agents that do the work",
  "short_name": "brocco",
  "description": "Multi-agent dashboard. Run multiple Claude or local LLM agents in parallel from one prompt. BYOK, browser-first.",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0A0A0F",
  "background_color": "#0A0A0F",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "developer", "business"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Open dashboard",
      "short_name": "Dashboard",
      "description": "Run agents in parallel",
      "url": "/app?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pricing",
      "short_name": "Pricing",
      "description": "Plans and tiers",
      "url": "/pricing",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/og.svg",
      "sizes": "1200x630",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Brocco multi-agent dashboard"
    }
  ],
  "prefer_related_applications": false
}
