# Keep the deploy payload small so builds do not time out uploading files.
# None of these are imported by the Next.js build or served by the live site.
# (The website reads lib/ + app/ + components/; assets it actually uses stay.)

# Content factory + renders (2.4GB) — used by local content tooling, not the site
marketing/
render/

# Internal / non-build dirs.
# NOTE: patterns are anchored with a leading slash so they only match the
# project-root folder, never a same-named route dir under app/. Without the
# anchor, a bare "docs/" also excluded app/docs/, which 404'd the live /docs
# page (fixed 2026-06-02).
/backups/
/research/
/sessions/
/session_logs/
/docs/
/__tests__/
/tests/

# Heavy public media the website does not reference
# (kept: agents-nano, cast-v7-video, factory, video, episodes-for-posting, icons)
public/assets/_bg_backup/
public/assets/personal/
public/assets/video-src/
